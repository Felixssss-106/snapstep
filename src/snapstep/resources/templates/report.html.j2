<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --accent:#f53f3f; --ink:#1f2329; --muted:#8a919f; --bg:#f7f8fa; --card:#ffffff; --border:#e5e6eb; --code-bg:#f2f3f5; }
  @media (prefers-color-scheme: dark) {
    :root { --ink:#e8eaed; --muted:#9aa0a6; --bg:#17181c; --card:#1f2025; --border:#33353b; --code-bg:#2a2c33; }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font-family:"PingFang SC","Microsoft YaHei","Segoe UI",system-ui,sans-serif;
         line-height:1.75; -webkit-font-smoothing:antialiased; }
  main { max-width:880px; margin:0 auto; padding:48px 20px 80px; }
  .meta { color:var(--muted); font-size:13px; letter-spacing:.02em; }
  h1 { font-size:30px; line-height:1.3; margin:10px 0 14px; }
  .intro { color:var(--muted); margin:0 0 36px; font-size:16px; }
  .step { background:var(--card); border:1px solid var(--border); border-radius:14px;
          padding:22px 24px; margin-bottom:26px; }
  .step-head { display:flex; align-items:center; gap:12px; margin-bottom:4px; }
  .num { flex:none; width:30px; height:30px; border-radius:50%; background:var(--accent);
         color:#fff; display:flex; align-items:center; justify-content:center;
         font-weight:600; font-size:15px; }
  h2 { font-size:19px; margin:0; }
  .desc { margin:8px 0 14px; }
  .typed { font-family:Consolas,Menlo,monospace; font-size:13px; background:var(--code-bg);
           border:1px solid var(--border); border-radius:6px; padding:2px 8px; }
  .shot { display:block; width:100%; border:1px solid var(--border); border-radius:10px; }
  footer { color:var(--muted); font-size:13px; text-align:center; margin-top:48px; }
  footer a { color:var(--muted); }
</style>
</head>
<body>
<main>
  <div class="meta">{{ generated }}</div>
  <h1>{{ title }}</h1>
  {% if intro %}<p class="intro">{{ intro }}</p>{% endif %}

  {% for s in steps %}
  <section class="step">
    <div class="step-head">
      <span class="num">{{ s.index }}</span>
      <h2>{{ s.title }}</h2>
    </div>
    {% if s.description %}<p class="desc">{{ s.description }}</p>{% endif %}
    {% if s.typed %}<p>输入：<span class="typed">{{ s.typed }}</span></p>{% endif %}
    {% if s.image %}<img class="shot" src="{{ s.image }}" alt="步骤 {{ s.index }} 截图">{% endif %}
  </section>
  {% endfor %}

  <footer>由 <a href="https://github.com/Felixssss-106/snapstep">SnapStep</a> 自动生成</footer>
</main>
</body>
</html>
